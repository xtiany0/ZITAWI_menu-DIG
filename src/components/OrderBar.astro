---
import { ui, WHATSAPP, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<a
  href={`https://wa.me/${WHATSAPP}`}
  target="_blank"
  rel="noopener noreferrer"
  data-whatsapp-fab
  aria-label={t.orderCta}
  class="fixed left-3 bottom-[calc(2.25rem+env(safe-area-inset-bottom))] z-40 grid h-11 w-11 place-items-center rounded-full bg-whatsapp text-[#0b3d1f] shadow-lg transition-transform duration-200 hover:scale-105 lg:left-auto lg:right-6 lg:bottom-8"
>
  <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
    <path
      d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.38a9.86 9.86 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.06c-.25.69-1.45 1.32-2 1.4-.51.08-1.16.11-1.87-.12-.43-.14-.99-.32-1.7-.63-2.99-1.29-4.95-4.3-5.1-4.5-.15-.2-1.22-1.62-1.22-3.09s.77-2.19 1.04-2.49c.27-.3.59-.37.79-.37h.57c.18 0 .43-.7.67.51.25.6.84 2.07.91 2.22.07.15.12.33.02.53-.1.2-.15.32-.3.5l-.45.52c-.15.15-.3.31-.13.61.17.3.76 1.25 1.63 2.02 1.12.99 2.06 1.3 2.36 1.45.3.15.47.13.64-.08.17-.2.74-.86.94-1.16.2-.3.4-.25.67-.15.27.1 1.72.81 2.01.96.3.15.5.22.57.35.07.12.07.72-.18 1.41Z"
    ></path>
  </svg>
</a>

<div
  data-order-bar
  hidden
  class="fixed inset-x-0 bottom-0 z-50 border-t border-white/10 bg-order px-4 py-3 lg:px-8"
>
  <div class="mx-auto flex max-w-6xl items-center gap-3">
    <button
      type="button"
      data-cart-clear
      aria-label={lang === "fr" ? "Vider la commande" : "Clear the order"}
      class="grid h-11 w-11 shrink-0 cursor-pointer place-items-center rounded-full bg-black/20 text-white transition-colors duration-200 hover:bg-black/35"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"></path>
      </svg>
    </button>

    <a
      data-cart-send
      href={`https://wa.me/${WHATSAPP}`}
      target="_blank"
      rel="noopener noreferrer"
      class="flex min-h-12 flex-1 flex-col items-center justify-center gap-0.5 rounded-full bg-white/10 px-4 text-center leading-tight font-semibold text-white transition-colors duration-200 hover:bg-white/20 sm:flex-row sm:gap-2 sm:text-base"
    >
      <span class="text-[0.8rem] sm:text-inherit">
        {t.orderCta} (<span data-cart-count>0</span>)
      </span>
      <span class="hidden sm:inline" aria-hidden="true">·</span>
      <span class="text-[0.9rem] sm:text-inherit">
        {t.total} <span data-cart-total>0</span> {t.currency}
      </span>
    </a>
  </div>
</div>

<script is:inline define:vars={{ whatsapp: WHATSAPP, intro: t.orderIntro, totalWord: t.orderTotal, currency: t.currency, locale: lang }}>
  const cart = new Map();

  const STORAGE_KEY = "zitawi-order-v1";
  // A menu order left over from yesterday is noise, not a convenience.
  const MAX_AGE_MS = 12 * 60 * 60 * 1000;

  function save() {
    try {
      const items = {};
      for (const [id, line] of cart) items[id] = line.qty;
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ savedAt: Date.now(), items }));
    } catch {
      // Private windows and blocked site data throw here. The order still works,
      // it just will not outlive the page.
    }
  }

  function restore() {
    let stored;
    try {
      stored = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "null");
    } catch {
      return;
    }
    if (!stored || typeof stored !== "object" || !stored.items) return;
    if (!Number.isFinite(stored.savedAt) || Date.now() - stored.savedAt > MAX_AGE_MS) return;

    for (const [id, qty] of Object.entries(stored.items)) {
      const amount = Number(qty);
      if (!Number.isInteger(amount) || amount < 1) continue;
      // Name and price are read back off the page, never out of storage, so a
      // dish the restaurant has repriced or removed cannot come back stale.
      const button = document.querySelector(`[data-add="${CSS.escape(id)}"]`);
      if (!button) continue;
      cart.set(id, {
        name: button.dataset.name,
        price: Number(button.dataset.price),
        qty: Math.min(amount, 99),
      });
    }
  }

  const bar = document.querySelector("[data-order-bar]");
  const countEl = document.querySelector("[data-cart-count]");
  const totalEl = document.querySelector("[data-cart-total]");
  const sendEl = document.querySelector("[data-cart-send]");
  const fab = document.querySelector("[data-whatsapp-fab]");

  const money = (value) => value.toLocaleString("en-US").replace(/,/g, locale === "fr" ? "." : ",");

  function render() {
    let count = 0;
    let total = 0;
    for (const line of cart.values()) {
      count += line.qty;
      total += line.qty * line.price;
    }

    const empty = count === 0;
    if (bar) bar.hidden = empty;
    document.body.dataset.cartOpen = String(!empty);
    if (fab) fab.hidden = !empty;
    if (countEl) countEl.textContent = String(count);
    if (totalEl) totalEl.textContent = money(total);

    document.querySelectorAll("[data-stepper]").forEach((group) => {
      const line = cart.get(group.dataset.stepper);
      const badge = group.querySelector("[data-qty]");
      const minus = group.querySelector("[data-remove]");
      group.dataset.active = String(Boolean(line));
      if (badge) {
        badge.hidden = !line;
        badge.textContent = line ? String(line.qty) : "";
      }
      if (minus) minus.hidden = !line;
    });

    if (sendEl) {
      const lines = [...cart.values()].map((line) => `${line.qty} x ${line.name}`);
      const text = `${intro}\n${lines.join("\n")}\n${totalWord} : ${money(total)} ${currency}`;
      sendEl.href = `https://wa.me/${whatsapp}?text=${encodeURIComponent(text)}`;
    }

    save();
  }

  document.querySelectorAll("[data-add]").forEach((button) => {
    button.addEventListener("click", () => {
      const id = button.dataset.add;
      const line = cart.get(id);
      if (line) line.qty = Math.min(line.qty + 1, 99);
      else cart.set(id, { name: button.dataset.name, price: Number(button.dataset.price), qty: 1 });
      render();
    });
  });

  document.querySelectorAll("[data-remove]").forEach((button) => {
    button.addEventListener("click", () => {
      const id = button.dataset.remove;
      const line = cart.get(id);
      if (!line) return;
      if (line.qty > 1) line.qty -= 1;
      else cart.delete(id);
      render();
    });
  });

  document.querySelector("[data-cart-clear]")?.addEventListener("click", () => {
    cart.clear();
    render();
  });

  restore();
  render();
</script>
