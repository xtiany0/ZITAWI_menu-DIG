---
import { ui, PHONE, PHONE_DISPLAY, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<footer class="bg-footer-bg px-[18px] pt-[18px] pb-5 font-body text-[12.5px] leading-[1.7] text-footer-text">
  <p class="font-logo text-[17px] font-black text-band">ZITAWI</p>
  <p>{t.footerPlace}</p>
  <p>{t.hours}</p>
  <p>
    <a href={`tel:${PHONE}`} class="font-bold text-band underline-offset-2 hover:underline">
      {PHONE_DISPLAY}
    </a>
  </p>
  <p>{t.footerPrices}</p>
</footer>
