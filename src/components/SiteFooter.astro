---
import { ui, PHONE, PHONE_DISPLAY, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  updatedAt: string;
}

const { lang, updatedAt } = Astro.props;
const t = ui[lang];
---

<footer class="border-t border-rule">
  <div class="mx-auto max-w-5xl px-5 py-14 text-center lg:px-8 lg:py-20">
    <p class="reveal font-display text-2xl tracking-[0.02em] lg:text-3xl">Zitawi</p>
    <p class="reveal mt-3 text-sm text-muted">{t.address} · {t.hours}</p>

    <a
      href={`tel:${PHONE}`}
      class="reveal mt-7 inline-flex min-h-12 cursor-pointer items-center bg-red px-7 text-sm tracking-[0.06em] text-on-red uppercase transition-colors duration-200 hover:bg-ink"
    >
      {t.heroCall} · {PHONE_DISPLAY}
    </a>

    <span class="mx-auto mt-10 block h-px w-16 bg-rule" aria-hidden="true"></span>

    <p class="mt-6 text-[0.78rem] text-muted">{t.footerNote}</p>
    <p class="mt-1.5 text-[0.78rem] text-muted">{t.updated} {updatedAt}</p>
  </div>
</footer>
