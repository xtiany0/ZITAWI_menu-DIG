---
import { ui, PHONE, PHONE_DISPLAY, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  updatedAt: string;
}

const { lang, updatedAt } = Astro.props;
const t = ui[lang];
---

<footer class="mt-14 border-t border-line pt-8 pb-16">
  <p class="font-display text-xl tracking-[0.06em] text-gold">ZITAWI</p>
  <p class="mt-2 text-sm text-muted">{t.address} · {t.hours}</p>

  <a
    href={`tel:${PHONE}`}
    class="mt-4 inline-flex min-h-12 cursor-pointer items-center rounded-full bg-card px-5 text-sm font-semibold text-ink transition-colors duration-200 hover:bg-card-hi"
  >
    {PHONE_DISPLAY}
  </a>

  <p class="mt-6 text-[0.8rem] text-muted">{t.footerNote}</p>
  <p class="mt-1 text-[0.8rem] text-muted">{t.updated} {updatedAt}</p>
</footer>
