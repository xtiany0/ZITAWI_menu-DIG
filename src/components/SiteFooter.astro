---
import { ui, PHONE, PHONE_DISPLAY, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  updatedAt: string;
}

const { lang, updatedAt } = Astro.props;
const t = ui[lang];
---

<footer class="mt-12 border-t border-rule pt-8 pb-12">
  <a
    href={`tel:${PHONE}`}
    class="inline-flex min-h-12 w-full cursor-pointer items-center justify-center bg-orange px-6 text-sm font-bold text-white transition-colors duration-200 hover:bg-ink sm:w-auto"
  >
    {t.heroCall} · {PHONE_DISPLAY}
  </a>

  <p class="mt-5 text-sm text-muted">{t.address} · {t.hours}</p>
  <p class="mt-1 text-[0.8rem] text-muted">{t.footerNote}</p>
  <p class="mt-1 text-[0.8rem] text-muted">{t.updated} {updatedAt}</p>
</footer>
