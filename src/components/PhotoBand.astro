---
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<!-- Cropped from the restaurant's printed menu. Low resolution by origin, so it
     is shown below its native 608px width and never upscaled. -->
<section class="mx-auto max-w-5xl px-5 pb-14 lg:px-8 lg:pb-20">
  <figure class="reveal mx-auto max-w-[540px]">
    <img
      src="/images/bandeau.webp"
      alt={t.bandAlt}
      width="608"
      height="148"
      loading="lazy"
      decoding="async"
      class="w-full border border-rule"
    />
    <figcaption class="mt-3 text-center text-[0.72rem] tracking-[0.16em] text-muted uppercase">
      {t.origin}
    </figcaption>
  </figure>
</section>
