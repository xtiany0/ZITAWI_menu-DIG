---
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<!-- Cropped from the restaurant's printed menu. Low resolution by origin, so it
     is never shown above its native 608px and is tinted to match the palette. -->
<section class="mx-auto max-w-6xl px-5 pb-16 lg:px-8 lg:pb-24">
  <figure class="reveal relative overflow-hidden rounded-card border border-line bg-surface">
    <img
      src="/images/bandeau.webp"
      alt={t.bandAlt}
      width="608"
      height="148"
      loading="lazy"
      decoding="async"
      class="duotone h-36 w-full object-cover lg:h-44"
    />
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-accent/35 via-transparent to-accent-2/25 mix-blend-overlay"
      aria-hidden="true"
    >
    </div>
    <figcaption
      class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-bg via-bg/80 to-transparent px-5 py-4 lg:px-6"
    >
      <span class="font-mono text-[0.7rem] tracking-[0.08em] text-muted">{t.origin}</span>
    </figcaption>
  </figure>
</section>
