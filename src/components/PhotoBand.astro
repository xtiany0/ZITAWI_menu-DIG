---
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<!-- Cropped from the restaurant's printed menu, reduced to a 152px greyscale
     bitmap and scaled back with nearest-neighbour. The coarse halftone turns
     the low source resolution into a print texture. -->
<section class="border-b-2 border-ink">
  <figure class="grid grid-cols-1 gap-px bg-ink lg:grid-cols-12">
    <img
      src="/images/bandeau-trame.png"
      alt={t.bandAlt}
      width="608"
      height="148"
      loading="lazy"
      decoding="async"
      class="bitmap h-full w-full bg-substrate object-cover lg:col-span-8"
    />
    <figcaption
      class="flex flex-col justify-between gap-6 bg-substrate px-4 py-4 text-[0.65rem] tracking-[0.08em] uppercase lg:col-span-4 lg:px-6 lg:py-5 lg:text-[0.7rem]"
    >
      <span class="text-ink-soft">[ TRAME 152PX / 16 NIV. ]</span>
      <span class="font-display text-accent" style="font-size:clamp(1.25rem,3vw,2rem);line-height:0.9;letter-spacing:-0.03em">
        {t.origin}
      </span>
    </figcaption>
  </figure>
</section>
