---
import { ui, formatPrice, type Lang } from "../i18n/ui";
import type { CATEGORIES } from "../content.config";

export interface MenuEntry {
  id: string;
  name: string;
  description: string;
  price: number;
  priceAlt?: number;
  options: string[];
  image?: string;
  available: boolean;
}

interface Props {
  lang: Lang;
  category: (typeof CATEGORIES)[number];
  entries: MenuEntry[];
}

const { lang, category, entries } = Astro.props;
const t = ui[lang];
const categoryLabel = t.categories[category];

/** Strip accents so "pecheur" finds "pêcheur". */
const norm = (value: string) =>
  value
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .toLowerCase();

function pricesOf(entry: MenuEntry) {
  return typeof entry.priceAlt === "number" ? [entry.price, entry.priceAlt] : [entry.price];
}

/** "nature · 2.000 F" when the dish names its options, otherwise "6.000 F". */
function optionLabels(entry: MenuEntry) {
  const prices = pricesOf(entry);
  if (prices.length < 2) return [];
  const named = entry.options.length === prices.length;
  return prices.map(
    (price, index) =>
      `${named ? `${entry.options[index]} · ` : ""}${formatPrice(price, lang)} F`,
  );
}
---

<section data-section data-cat={category} class="hidden">
  <div class="flex items-baseline justify-between gap-4 bg-maroon px-[18px] py-[10px]">
    <h2 class="font-body text-[17px] font-extrabold tracking-[.34em] text-white uppercase">
      {categoryLabel}
    </h2>
    <span data-count class="font-mono text-[11px] text-blush-dim"></span>
  </div>

  {
    entries.map((entry) => {
      const prices = pricesOf(entry);
      const labels = optionLabels(entry);
      const showSlot = !entry.image && category !== "pizzas";

      return (
        <article
          data-row
          data-cat={category}
          data-cat-label={categoryLabel}
          data-name={entry.name}
          data-prices={JSON.stringify(prices)}
          data-labels={JSON.stringify(labels)}
          data-search={norm(`${entry.name} ${entry.description} ${entry.options.join(" ")}`)}
          class="hidden min-h-[84px] items-center gap-[14px] px-[18px] py-[11px]"
        >
          {entry.image ? (
            <img
              src={entry.image}
              alt={entry.name}
              width="144"
              height="144"
              loading="lazy"
              decoding="async"
              class="medallion h-[72px] w-[72px] shrink-0 rounded-full bg-white object-cover shadow-[0_0_0_3px_#fffdf3,0_3px_8px_-2px_rgba(20,18,16,.35)]"
            />
          ) : showSlot ? (
            <span
              class="grid h-[72px] w-[72px] shrink-0 place-items-center rounded-full bg-cream font-mono text-[8px] text-[#b3a276] shadow-[0_0_0_3px_#fffdf3,0_3px_8px_-2px_rgba(20,18,16,.35)]"
              aria-hidden="true"
            >
              {t.photoSlot}
            </span>
          ) : null}

          <div class="min-w-0 flex-1">
            <h3 class="font-narrow text-[18px] leading-tight font-bold text-ink uppercase">
              {entry.name}
            </h3>

            {entry.description && labels.length === 0 && (
              <p class="mt-0.5 font-body text-[12px] leading-snug text-ink-soft">
                ({entry.description})
              </p>
            )}

            {labels.length > 0 && (
              <div class="mt-1.5 flex flex-wrap gap-1.5">
                {labels.map((label, index) => (
                  <button
                    type="button"
                    data-opt={index}
                    aria-pressed={index === 0 ? "true" : "false"}
                    class="rounded-full border-[1.5px] border-ink bg-white/50 px-2.5 py-1 font-narrow text-[12px] font-bold text-[#5f5741] aria-pressed:bg-ink aria-pressed:text-band"
                  >
                    {label}
                  </button>
                ))}
              </div>
            )}
          </div>

          <div class="shrink-0 text-right">
            <p class="font-body text-[18px] font-extrabold text-ink">
              <span data-price-out>{formatPrice(entry.price, lang)}</span>
              <span class="text-[13px] font-black"> F</span>
            </p>

            <div
              class="mt-1.5 inline-flex items-center gap-1 rounded-full border-[1.5px] border-ink bg-cream p-[2px]"
            >
              <button
                type="button"
                data-dec
                aria-label={`${t.remove} ${entry.name}`}
                class="tap grid h-[26px] w-[26px] place-items-center rounded-full font-body text-[15px] font-extrabold text-ink transition-colors hover:bg-band"
              >
                −
              </button>
              <span data-qty class="min-w-[14px] text-center font-body text-[14px] font-extrabold text-mute">
                0
              </span>
              <button
                type="button"
                data-inc
                aria-label={`${t.add} ${entry.name}`}
                class="tap grid h-[26px] w-[26px] place-items-center rounded-full bg-ink font-body text-[15px] font-extrabold text-band transition-colors hover:bg-terracotta hover:text-white"
              >
                +
              </button>
            </div>
          </div>
        </article>
      );
    })
  }
</section>
