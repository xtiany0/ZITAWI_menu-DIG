---
import { ui, formatPrice, type Lang } from "../i18n/ui";
import type { CATEGORIES } from "../content.config";

export interface MenuEntry {
  id: string;
  name: string;
  description: string;
  price: number;
  priceNote: string;
  image?: string;
  available: boolean;
}

interface Props {
  lang: Lang;
  category: (typeof CATEGORIES)[number];
  variant: "cards" | "rows";
  entries: MenuEntry[];
}

const { lang, category, variant, entries } = Astro.props;
const t = ui[lang];
---

<section
  id={category}
  data-category-section={category}
  class="mx-auto w-full max-w-6xl scroll-mt-32 px-5 py-12 lg:px-8 lg:py-20"
>
  <div class="max-w-[46ch]">
    <h2
      class="font-display text-3xl leading-tight font-semibold tracking-tight text-ink lg:text-4xl"
    >
      {t.categories[category]}
    </h2>
    <div class="mt-4 h-[3px] w-14 rounded-full bg-gold" aria-hidden="true"></div>
    <p class="mt-4 text-sm leading-relaxed text-muted lg:text-base">
      {t.categoryBlurb[category]}
    </p>
  </div>

  {
    entries.length === 0 ? (
      <p class="mt-8 rounded-card border border-dashed border-line px-5 py-8 text-center text-sm text-muted">
        {lang === "fr"
          ? "Aucun plat disponible dans cette catégorie pour le moment."
          : "No dishes available in this category right now."}
      </p>
    ) : variant === "cards" ? (
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:mt-10 lg:gap-4">
        {entries.map((entry) => (
          <li
            class:list={[
              "rounded-card border border-line bg-raised p-5 shadow-soft transition-colors duration-200 hover:border-accent/40",
              !entry.available && "opacity-55",
            ]}
          >
            {entry.image && (
              <img
                src={entry.image}
                alt={entry.name}
                loading="lazy"
                decoding="async"
                width="640"
                height="420"
                class="mb-4 aspect-[3/2] w-full rounded-[10px] object-cover"
              />
            )}
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-display text-lg font-semibold text-ink">{entry.name}</h3>
              <p class="font-display font-semibold tabular-nums whitespace-nowrap text-accent">
                {formatPrice(entry.price, lang)}
                <span class="text-xs font-medium text-muted"> {t.currency}</span>
              </p>
            </div>
            {entry.description && (
              <p class="mt-2 text-sm leading-relaxed text-muted">{entry.description}</p>
            )}
            {entry.priceNote && (
              <p class="mt-2 text-xs font-medium text-muted">{entry.priceNote}</p>
            )}
            {!entry.available && (
              <p class="mt-3 inline-block rounded-full border border-line px-3 py-1 text-xs font-medium text-muted">
                {t.soldOut}
              </p>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <ul class="mt-8 grid gap-x-12 sm:grid-cols-2 lg:mt-10">
        {entries.map((entry) => (
          <li
            class:list={[
              "flex items-baseline justify-between gap-5 border-b border-line py-3.5",
              !entry.available && "opacity-55",
            ]}
          >
            <span class="text-ink">
              {entry.name}
              {entry.description && (
                <span class="block text-sm text-muted">{entry.description}</span>
              )}
              {!entry.available && (
                <span class="block text-xs font-medium text-muted">{t.soldOut}</span>
              )}
            </span>
            <span class="font-display font-semibold tabular-nums whitespace-nowrap text-accent">
              {formatPrice(entry.price, lang)}
              <span class="text-xs font-medium text-muted"> {t.currency}</span>
              {entry.priceNote && (
                <span class="block text-right text-xs font-normal text-muted">
                  {entry.priceNote}
                </span>
              )}
            </span>
          </li>
        ))}
      </ul>
    )
  }
</section>
