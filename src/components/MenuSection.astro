---
import { ui, formatPrice, type Lang } from "../i18n/ui";
import type { CATEGORIES } from "../content.config";

export interface MenuEntry {
  id: string;
  name: string;
  description: string;
  price: number;
  priceNote: string;
  image?: string;
  available: boolean;
}

interface Props {
  lang: Lang;
  category: (typeof CATEGORIES)[number];
  entries: MenuEntry[];
}

const { lang, category, entries } = Astro.props;
const t = ui[lang];
---

<section
  id={category}
  data-category-section={category}
  class="mx-auto max-w-5xl scroll-mt-20 px-5 py-14 lg:px-8 lg:py-20"
>
  <header class="reveal text-center">
    <h2 class="font-display text-[clamp(1.75rem,5vw,2.5rem)] tracking-[0.02em]">
      {t.categories[category]}
    </h2>
    <p class="mt-3 text-sm text-muted">{t.categoryBlurb[category]}</p>
    <span class="mx-auto mt-5 block h-px w-16 bg-gold" aria-hidden="true"></span>
  </header>

  {
    entries.length === 0 ? (
      <p class="mt-10 text-center text-sm text-muted">{t.empty}</p>
    ) : (
      <ul class="mt-10 grid gap-x-12 gap-y-7 lg:grid-cols-2">
        {entries.map((entry, row) => (
          <li
            class="reveal flex gap-4"
            style={`--reveal-delay:${Math.min(row, 6) * 40}ms`}
          >
            {entry.image && (
              <img
                src={entry.image}
                alt={entry.name}
                loading="lazy"
                decoding="async"
                width="128"
                height="128"
                class="mt-1 h-16 w-16 shrink-0 object-cover"
              />
            )}

            <div class="min-w-0 flex-1">
            <div class="flex items-baseline gap-2">
              <h3
                class:list={[
                  "font-display text-[1.05rem] tracking-[0.01em]",
                  !entry.available && "text-muted line-through decoration-red-soft/60",
                ]}
              >
                {entry.name}
              </h3>
              <span class="leader" aria-hidden="true" />
              <p class="shrink-0 text-[1.05rem] tabular-nums text-gold">
                {formatPrice(entry.price, lang)}
                <span class="text-[0.7rem] tracking-[0.08em] text-muted"> {t.currency}</span>
              </p>
            </div>

            {entry.description && (
              <p class="mt-1.5 max-w-[54ch] text-[0.85rem] leading-relaxed text-muted">
                {entry.description}
              </p>
            )}

            {(entry.priceNote || !entry.available) && (
              <p class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1">
                {entry.priceNote && (
                  <span class="text-[0.78rem] text-muted italic">{entry.priceNote}</span>
                )}
                {!entry.available && (
                  <span class="text-[0.7rem] tracking-[0.14em] text-red-soft uppercase">
                    {t.soldOut}
                  </span>
                )}
              </p>
            )}
            </div>
          </li>
        ))}
      </ul>
    )
  }
</section>
