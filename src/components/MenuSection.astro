---
import { ui, formatPrice, pad, type Lang } from "../i18n/ui";
import type { CATEGORIES } from "../content.config";

export interface MenuEntry {
  id: string;
  name: string;
  description: string;
  price: number;
  priceNote: string;
  image?: string;
  available: boolean;
}

interface Props {
  lang: Lang;
  category: (typeof CATEGORIES)[number];
  index: number;
  entries: MenuEntry[];
}

const { lang, category, index, entries } = Astro.props;
const t = ui[lang];
---

<section id={category} data-category-section={category} class="scroll-mt-24 border-b-2 border-ink">
  <header class="grid grid-cols-[auto_1fr] items-end gap-4 border-b-2 border-ink px-4 pt-6 pb-3 lg:gap-8 lg:px-6 lg:pt-10 lg:pb-4">
    <span
      class="font-display leading-[0.8] text-accent"
      style="font-size:clamp(3rem,9vw,7rem);letter-spacing:-0.05em"
      aria-hidden="true">{pad(index).slice(1)}</span
    >
    <div class="pb-1">
      <h2
        class="font-display uppercase"
        style="font-size:clamp(1.5rem,4.5vw,3rem);line-height:0.9;letter-spacing:-0.035em"
      >
        {t.categories[category]}
      </h2>
      <p class="mt-2 text-[0.65rem] tracking-[0.08em] text-ink-soft uppercase lg:text-xs">
        {t.categoryBlurb[category]} /// {entries.length} {t.refs}
      </p>
    </div>
  </header>

  {
    entries.length === 0 ? (
      <p class="px-4 py-10 text-center text-xs tracking-[0.1em] text-ink-soft uppercase lg:px-6">
        [ {lang === "fr" ? "AUCUNE RÉFÉRENCE DISPONIBLE" : "NO REFERENCE AVAILABLE"} ]
      </p>
    ) : (
      <ul class="grid gap-px bg-ink/15">
        {entries.map((entry, row) => (
          <li
            class:list={[
              "grid grid-cols-[3rem_1fr] items-baseline gap-x-3 bg-substrate px-4 py-3 lg:grid-cols-[4rem_minmax(0,4fr)_minmax(0,5fr)_8rem] lg:gap-x-6 lg:px-6 lg:py-3.5",
              !entry.available && "text-ink-soft",
            ]}
          >
            <div class="col-start-1 row-span-full self-start">
              <span class="block text-[0.65rem] tabular-nums text-ink-soft lg:text-xs">
                {pad(row + 1)}
              </span>
              {entry.image && (
                <img
                  src={entry.image}
                  alt={entry.name}
                  loading="lazy"
                  decoding="async"
                  width="96"
                  height="96"
                  class="mt-2 h-10 w-10 object-cover grayscale contrast-125 lg:h-12 lg:w-12"
                />
              )}
            </div>

            <h3
              class:list={[
                "font-display text-sm uppercase lg:text-base",
                !entry.available && "line-through decoration-accent decoration-2",
              ]}
            >
              {entry.name}
            </h3>

            <p class="col-start-2 text-[0.65rem] leading-relaxed tracking-[0.04em] text-ink-soft uppercase lg:col-start-3 lg:text-[0.7rem]">
              {entry.description}
              {!entry.available && <span class="text-accent"> [ {t.soldOut} ]</span>}
            </p>

            <p class="col-start-2 mt-1 text-xs tabular-nums lg:col-start-4 lg:mt-0 lg:text-right lg:text-sm">
              <span class="text-accent">{formatPrice(entry.price, lang)}</span>
              <span class="text-[0.6rem] text-ink-soft"> {t.currency}</span>
              {entry.priceNote && (
                <span class="block text-[0.6rem] tracking-[0.05em] text-ink-soft uppercase lg:text-right">
                  {entry.priceNote}
                </span>
              )}
            </p>
          </li>
        ))}
      </ul>
    )
  }
</section>
