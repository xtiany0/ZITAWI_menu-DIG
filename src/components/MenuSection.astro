---
import { ui, formatPrice, type Lang } from "../i18n/ui";
import { withBase } from "../lib/path";
import type { CATEGORIES } from "../content.config";

export interface MenuEntry {
  id: string;
  name: string;
  description: string;
  price: number;
  priceAlt?: number;
  options: string[];
  image?: string;
  available: boolean;
}

interface Props {
  lang: Lang;
  category: (typeof CATEGORIES)[number];
  entries: MenuEntry[];
}

const { lang, category, entries } = Astro.props;
const t = ui[lang];
const categoryLabel = t.categories[category];

/** Strip accents so "pecheur" finds "pêcheur". */
const norm = (value: string) =>
  value
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .toLowerCase();

function pricesOf(entry: MenuEntry) {
  return typeof entry.priceAlt === "number" ? [entry.price, entry.priceAlt] : [entry.price];
}

/** "nature · 2.000 F" when the dish names its options, otherwise "6.000 F". */
function optionLabels(entry: MenuEntry) {
  const prices = pricesOf(entry);
  if (prices.length < 2) return [];
  const named = entry.options.length === prices.length;
  return prices.map(
    (price, index) =>
      `${named ? `${entry.options[index]} · ` : ""}${formatPrice(price, lang)} F`,
  );
}
---

<section data-section data-cat={category} class="hidden">
  <div class="flex items-center gap-3 bg-paper px-[18px] pt-6 pb-3">
    <h2 class="mark font-body text-[20px] leading-none font-extrabold tracking-[.16em] text-on uppercase">
      {categoryLabel}
    </h2>
    <span class="h-[2px] flex-1 bg-rule" aria-hidden="true"></span>
    <span data-count class="font-mono text-[11px] text-mute"></span>
  </div>

  {
    entries.map((entry) => {
      const prices = pricesOf(entry);
      const labels = optionLabels(entry);
      const showSlot = !entry.image && category !== "pizzas";

      return (
        <article
          data-row
          data-cat={category}
          data-cat-label={categoryLabel}
          data-name={entry.name}
          data-prices={JSON.stringify(prices)}
          data-labels={JSON.stringify(labels)}
          data-search={norm(`${entry.name} ${entry.description} ${entry.options.join(" ")}`)}
          class="hidden min-h-[84px] items-center gap-[14px] border-b border-row-line bg-paper px-[18px] py-[11px]"
        >
          {entry.image ? (
            <img
              src={withBase(entry.image)}
              alt={entry.name}
              width="136"
              height="136"
              loading="lazy"
              decoding="async"
              class="medallion h-[68px] w-[68px] shrink-0 rounded-full bg-white object-cover shadow-[0_0_0_1px_var(--color-ring)]"
            />
          ) : showSlot ? (
            <span
              class="grid h-[68px] w-[68px] shrink-0 place-items-center rounded-full bg-slot font-mono text-[8px] text-slot-ink shadow-[0_0_0_1px_var(--color-ring)]"
              aria-hidden="true"
            >
              {t.photoSlot}
            </span>
          ) : null}

          <div class="min-w-0 flex-1">
            <h3 class="font-narrow text-[18px] leading-tight font-bold text-ink uppercase">
              {entry.name}
            </h3>

            {entry.description && labels.length === 0 && (
              <p class="mt-0.5 font-body text-[12px] leading-snug text-muted">
                ({entry.description})
              </p>
            )}

            {labels.length > 0 && (
              <div class="mt-1.5 flex flex-wrap gap-1.5">
                {labels.map((label, index) => (
                  <button
                    type="button"
                    data-opt={index}
                    aria-pressed={index === 0 ? "true" : "false"}
                    class="rounded-full border border-edge bg-field/50 px-2.5 py-1 font-narrow text-[12px] font-bold text-muted aria-pressed:border-on aria-pressed:bg-on aria-pressed:text-on-ink"
                  >
                    {label}
                  </button>
                ))}
              </div>
            )}
          </div>

          <div class="shrink-0 text-right">
            <p class="font-body text-[18px] font-extrabold text-ink">
              <span data-price-out>{formatPrice(entry.price, lang)}</span>
              <span class="text-[12px] font-extrabold"> F</span>
            </p>

            <div
              class="mt-1.5 inline-flex items-center gap-1 rounded-full border border-edge bg-field p-[2px]"
            >
              <button
                type="button"
                data-dec
                aria-label={`${t.remove} ${entry.name}`}
                class="tap grid h-[26px] w-[26px] place-items-center rounded-full font-body text-[15px] font-extrabold text-muted transition-colors hover:bg-slot"
              >
                −
              </button>
              <span data-qty data-on="false" class="min-w-[14px] text-center font-body text-[14px] font-extrabold">
                0
              </span>
              <button
                type="button"
                data-inc
                aria-label={`${t.add} ${entry.name}`}
                class="tap grid h-[26px] w-[26px] place-items-center rounded-full bg-band font-body text-[15px] font-extrabold text-black transition-colors hover:bg-black hover:text-band"
              >
                +
              </button>
            </div>
          </div>
        </article>
      );
    })
  }
</section>
