---
import { ui, formatPrice, type Lang } from "../i18n/ui";
import type { CATEGORIES } from "../content.config";

export interface MenuEntry {
  id: string;
  name: string;
  description: string;
  price: number;
  priceAlt?: number;
  image?: string;
  available: boolean;
}

interface Props {
  lang: Lang;
  category: (typeof CATEGORIES)[number];
  entries: MenuEntry[];
  banner?: string;
}

const { lang, category, entries, banner } = Astro.props;
const t = ui[lang];
---

<section id={category} data-category-section={category} class="scroll-mt-36 pt-9 lg:pt-12">
  <h2 class="bg-ink px-4 py-3 text-xl font-bold text-on-bar lg:px-5 lg:text-2xl">
    {t.categories[category]}
  </h2>

  {
    banner && (
      <img
        src={banner}
        alt={t.bandAlt}
        width="615"
        height="210"
        loading="lazy"
        decoding="async"
        class="mt-1.5 h-40 w-full object-cover lg:h-56"
      />
    )
  }

  {
    entries.length === 0 ? (
      <p class="py-10 text-center text-sm text-muted">{t.empty}</p>
    ) : (
      <ul class="mt-1">
        {entries.map((entry) => (
          <li class="flex items-center gap-4 border-b border-rule py-3">
            {entry.image && (
              <img
                src={entry.image}
                alt={entry.name}
                width="180"
                height="125"
                loading="lazy"
                decoding="async"
                class="h-14 w-[4.5rem] shrink-0 object-cover lg:h-16 lg:w-20"
              />
            )}

            <div class="min-w-0 flex-1">
              <h3
                class:list={[
                  "text-[0.95rem] font-bold text-ink lg:text-base",
                  !entry.available && "text-muted line-through",
                ]}
              >
                {entry.name}
              </h3>
              {entry.description && (
                <p class="mt-0.5 text-[0.8rem] leading-snug text-muted">{entry.description}</p>
              )}
              {!entry.available && (
                <p class="mt-0.5 text-[0.75rem] font-semibold text-orange">{t.soldOut}</p>
              )}
            </div>

            <p class="shrink-0 text-[0.95rem] font-bold tabular-nums text-orange lg:text-base">
              {[entry.price, entry.priceAlt]
                .filter((value): value is number => typeof value === "number")
                .map((value) => formatPrice(value, lang))
                .join(" / ") + t.currency}
            </p>
          </li>
        ))}
      </ul>
    )
  }
</section>
