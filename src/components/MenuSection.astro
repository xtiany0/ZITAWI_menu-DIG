---
import { ui, formatPrice, type Lang } from "../i18n/ui";
import type { CATEGORIES } from "../content.config";

export interface MenuEntry {
  id: string;
  name: string;
  description: string;
  price: number;
  priceAlt?: number;
  image?: string;
  available: boolean;
}

interface Props {
  lang: Lang;
  category: (typeof CATEGORIES)[number];
  entries: MenuEntry[];
  banner?: string;
}

const { lang, category, entries, banner } = Astro.props;
const t = ui[lang];

const priceLabel = (entry: MenuEntry) =>
  [entry.price, entry.priceAlt]
    .filter((value): value is number => typeof value === "number")
    .map((value) => formatPrice(value, lang))
    .join(" / ");
---

<section id={category} data-category-section={category} class="pt-8 lg:pt-12">
  <h2 class="text-xl font-semibold tracking-tight text-ink lg:text-2xl">
    {t.categories[category]}
    <span class="ml-2 text-sm font-normal text-muted">{entries.length}</span>
  </h2>

  {
    banner && (
      <img
        src={banner}
        alt={t.bandAlt}
        width="615"
        height="210"
        loading="lazy"
        decoding="async"
        class="mt-4 h-28 w-full rounded-card object-cover lg:h-36"
      />
    )
  }

  {
    entries.length === 0 ? (
      <p class="mt-6 text-sm text-muted">{t.empty}</p>
    ) : (
      <ul class="mt-4 grid gap-3 lg:grid-cols-2 lg:gap-4">
        {entries.map((entry) => (
          <li
            data-dish={`${entry.name} ${entry.description}`.toLowerCase()}
            class="flex items-stretch gap-3 rounded-card bg-card p-3 lg:gap-4 lg:p-4"
          >
            {entry.image && (
              <img
                src={entry.image}
                alt={entry.name}
                width="180"
                height="125"
                loading="lazy"
                decoding="async"
                class="h-24 w-24 shrink-0 rounded-xl object-cover lg:h-28 lg:w-28"
              />
            )}

            <div class="flex min-w-0 flex-1 flex-col">
              <h3
                class:list={[
                  "text-base leading-snug font-semibold text-ink lg:text-lg",
                  !entry.available && "text-muted line-through",
                ]}
              >
                {entry.name}
              </h3>

              {entry.description && (
                <p class="mt-1 line-clamp-2 text-[0.8rem] leading-snug text-muted lg:text-sm">
                  {entry.description}
                </p>
              )}

              <div class="mt-auto flex flex-wrap items-center justify-between gap-x-3 gap-y-2 pt-2">
                <p class="text-[0.95rem] font-bold text-ink lg:text-base">
                  {priceLabel(entry)}
                  <span class="ml-1 text-[0.7rem] font-medium text-muted">{t.currency}</span>
                </p>

                {entry.available ? (
                  <div
                    data-stepper={entry.id}
                    class="flex shrink-0 items-center gap-1 rounded-full border border-transparent p-1 transition-colors duration-200 data-[active=true]:border-orange data-[active=true]:bg-orange/10"
                  >
                    <button
                      type="button"
                      data-remove={entry.id}
                      hidden
                      aria-label={`${t.remove} ${entry.name}`}
                      class="grid h-11 w-11 cursor-pointer place-items-center rounded-full bg-card-hi text-ink transition-colors duration-200 hover:bg-line active:scale-95"
                    >
                      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <path d="M5 12h14" stroke-linecap="round" />
                      </svg>
                    </button>

                    <span
                      data-qty
                      hidden
                      aria-live="polite"
                      class="min-w-6 text-center text-sm font-bold text-orange"
                    />

                    <button
                      type="button"
                      data-add={entry.id}
                      data-name={entry.name}
                      data-price={entry.price}
                      aria-label={`${t.add} ${entry.name}`}
                      class="grid h-11 w-11 cursor-pointer place-items-center rounded-full bg-orange text-on-orange transition-transform duration-150 active:scale-95"
                    >
                      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" stroke-linecap="round" />
                      </svg>
                    </button>
                  </div>
                ) : (
                  <span class="rounded-full bg-card-hi px-3 py-1 text-[0.7rem] font-semibold text-muted">
                    {t.soldOut}
                  </span>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    )
  }
</section>
