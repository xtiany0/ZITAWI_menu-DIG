---
import { ui, formatPrice, pad, PHONE, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  signatures: { name: string; price: number }[];
  totalRefs: number;
}

const { lang, signatures, totalRefs } = Astro.props;
const t = ui[lang];
---

<section class="border-b-2 border-ink">
  <div class="grid gap-px bg-ink lg:grid-cols-12">
    <div class="bg-substrate px-4 pt-8 pb-6 lg:col-span-8 lg:px-6 lg:pt-12 lg:pb-10">
      <h1
        class="font-display uppercase"
        style="font-size:clamp(2.75rem,11vw,9rem);line-height:0.85;letter-spacing:-0.045em"
      >
        {
          t.heroWords.map((word, index) => (
            <span class="block">
              {index === 1 ? <span class="text-accent">{word}</span> : word}
            </span>
          ))
        }
      </h1>

      <p class="mt-6 max-w-[52ch] text-xs leading-relaxed tracking-[0.05em] uppercase lg:mt-8 lg:text-sm">
        {t.heroBody}
      </p>

      <div class="mt-6 inline-flex flex-wrap gap-px bg-ink lg:mt-8">
        <a
          href="#carte"
          class="bg-accent px-6 py-3 text-xs tracking-[0.1em] text-on-accent uppercase transition-transform duration-150 active:translate-y-px lg:text-sm"
        >
          {t.heroCta} &gt;&gt;&gt;
        </a>
        <a
          href={`tel:${PHONE}`}
          class="bg-substrate px-6 py-3 text-xs tracking-[0.1em] uppercase transition-colors duration-150 hover:bg-ink hover:text-substrate active:translate-y-px lg:text-sm"
        >
          {t.heroCall}
        </a>
      </div>
    </div>

    <div class="flex flex-col bg-substrate lg:col-span-4">
      <p
        class="border-b border-ink px-4 py-2 text-[0.625rem] tracking-[0.1em] uppercase lg:px-6 lg:text-[0.7rem]"
      >
        [ {t.popular} ]
      </p>
      <ul>
        {
          signatures.map((dish, index) => (
            <li class="flex items-baseline justify-between gap-3 border-b border-ink/15 px-4 py-3 text-[0.7rem] tracking-[0.05em] uppercase lg:px-6 lg:text-xs">
              <span class="flex gap-3">
                <span class="text-ink-soft">{pad(index + 1)}</span>
                <span>{dish.name}</span>
              </span>
              <span class="tabular-nums text-accent">{formatPrice(dish.price, lang)}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-auto hidden border-t border-ink px-4 py-5 lg:block lg:px-6">
        <p class="text-[0.7rem] tracking-[0.1em] text-ink-soft uppercase">
          {t.refs} {lang === "fr" ? "AU TOTAL" : "IN TOTAL"}
        </p>
        <p
          class="font-display tabular-nums"
          style="font-size:clamp(3rem,7vw,5.5rem);line-height:0.85;letter-spacing:-0.05em"
        >
          {totalRefs}
        </p>
      </div>
    </div>
  </div>
</section>
