---
import { ui, PHONE, PHONE_DISPLAY, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  totalRefs: number;
}

const { lang, totalRefs } = Astro.props;
const t = ui[lang];
---

<section class="mx-auto max-w-5xl px-5 pt-8 pb-14 text-center lg:px-8 lg:pt-16 lg:pb-20">
  <p class="reveal text-[0.72rem] tracking-[0.28em] text-gold uppercase">{t.origin}</p>

  <h1
    class="reveal mt-5 font-display text-[clamp(2.5rem,9vw,4.5rem)] leading-[1.05] tracking-[0.01em]"
    style="--reveal-delay:60ms"
  >
    {t.heroWords.join(", ")}
  </h1>

  <div class="reveal mx-auto mt-7 flex max-w-sm items-center gap-4" style="--reveal-delay:120ms">
    <span class="h-px flex-1 bg-rule"></span>
    <span class="text-[0.72rem] tracking-[0.2em] text-muted uppercase">
      {totalRefs}
      {t.refs}
    </span>
    <span class="h-px flex-1 bg-rule"></span>
  </div>

  <p
    class="reveal mx-auto mt-7 max-w-[44ch] text-[0.95rem] leading-relaxed text-muted lg:text-base"
    style="--reveal-delay:160ms"
  >
    {t.heroBody}
  </p>

  <div
    class="reveal mt-9 flex flex-wrap items-center justify-center gap-3"
    style="--reveal-delay:200ms"
  >
    <a
      href="#carte"
      class="inline-flex min-h-12 cursor-pointer items-center bg-red px-7 text-sm tracking-[0.06em] text-on-red uppercase transition-colors duration-200 hover:brightness-110"
    >
      {t.heroCta}
    </a>
    <a
      href={`tel:${PHONE}`}
      class="inline-flex min-h-12 cursor-pointer items-center border border-rule px-7 text-sm tracking-[0.06em] uppercase transition-colors duration-200 hover:border-gold"
    >
      {t.heroCall}
    </a>
  </div>

  <p class="reveal mt-7 text-[0.8rem] text-muted" style="--reveal-delay:240ms">
    {t.hours} · {PHONE_DISPLAY}
  </p>
</section>
