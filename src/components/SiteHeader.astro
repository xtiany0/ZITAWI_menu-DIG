---
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<header class="mx-auto flex max-w-5xl items-center justify-between px-5 py-5 lg:px-8">
  <a href={`/${lang}/`} class="font-display text-xl tracking-[0.02em] lg:text-2xl">Zitawi</a>

  <a
    href={t.otherLangHref}
    hreflang={lang === "fr" ? "en" : "fr"}
    class="inline-flex min-h-11 cursor-pointer items-center border-b border-transparent px-1 text-sm tracking-[0.12em] text-muted uppercase transition-colors duration-200 hover:border-gold hover:text-ink"
  >
    {t.otherLang}
  </a>
</header>
