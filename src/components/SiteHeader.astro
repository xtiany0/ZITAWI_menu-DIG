---
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<header class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-5 lg:h-20 lg:px-8">
  <a href={`/${lang}/`} class="flex items-baseline gap-2">
    <span class="font-display text-2xl font-semibold tracking-tight text-ink lg:text-[1.7rem]">
      Zitawi
    </span>
    <span class="text-[0.7rem] font-medium uppercase tracking-[0.2em] text-muted">
      {t.tagline}
    </span>
  </a>

  <a
    href={t.otherLangHref}
    hreflang={lang === "fr" ? "en" : "fr"}
    class="rounded-full border border-line px-4 py-1.5 text-sm font-medium text-ink transition-colors duration-200 hover:border-accent hover:text-accent active:scale-[0.98]"
  >
    {t.otherLang}
  </a>
</header>
