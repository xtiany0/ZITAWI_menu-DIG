---
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<header class="mx-auto flex max-w-6xl items-center justify-between px-5 py-5 lg:px-8 lg:py-7">
  <a href={`/${lang}/`} class="group flex items-center gap-2.5">
    <span
      class="grid h-9 w-9 place-items-center rounded-xl bg-accent text-base font-semibold text-on-accent shadow-[0_0_24px_-4px_var(--color-accent)]"
      aria-hidden="true">Z</span
    >
    <span class="flex flex-col leading-none">
      <span class="text-[0.95rem] font-semibold tracking-tight">Zitawi</span>
      <span class="mt-1 font-mono text-[0.65rem] tracking-[0.08em] text-muted">{t.origin}</span>
    </span>
  </a>

  <a
    href={t.otherLangHref}
    hreflang={lang === "fr" ? "en" : "fr"}
    class="inline-flex min-h-11 cursor-pointer items-center rounded-full border border-line bg-surface/70 px-4 font-mono text-xs tracking-[0.08em] text-muted backdrop-blur transition-colors duration-200 hover:border-accent/60 hover:text-ink"
  >
    {t.otherLang}
  </a>
</header>
