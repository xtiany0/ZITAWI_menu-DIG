---
import { ui, type Lang } from "../i18n/ui";
import type { CATEGORIES } from "../content.config";
import { withBase } from "../lib/path";

interface Props {
  lang: Lang;
  categories: (typeof CATEGORIES)[number][];
}

const { lang, categories } = Astro.props;
const t = ui[lang];
---

<header>
  <div class="relative border-b-[5px] border-ink bg-terracotta px-5 pt-[15px] pb-[13px] text-center">
    <a href={withBase(`/${lang}/`)} class="logo block px-10 font-logo text-[34px] leading-none font-black tracking-[.11em] lg:text-[44px]">
      ZITAWI
    </a>
    <p class="mt-1 font-narrow text-[12px] font-semibold tracking-[.2em] text-blush uppercase lg:text-[13px]">
      {t.tagline}
    </p>

    <div
      data-lang-switch
      class="absolute top-2 right-2 flex flex-col rounded-lg border-2 border-ink bg-cream p-[2px] shadow-[2px_2px_0_#141210] lg:top-4 lg:right-5"
    >
      <span
        data-lang-knob
        aria-hidden="true"
        class:list={[
          "absolute top-[2px] left-[2px] h-[calc(50%-2px)] w-[calc(100%-4px)] rounded-[6px] bg-ink transition-transform duration-200 ease-out",
          lang === "en" && "translate-y-full",
        ]}
      />
      <a
        href={withBase("/fr/")}
        hreflang="fr"
        data-lang-seg="fr"
        aria-current={lang === "fr" ? "true" : "false"}
        class="relative z-10 w-[26px] py-[3px] text-center font-narrow text-[10px] leading-none font-bold text-ink transition-colors duration-200 aria-[current=true]:text-band"
      >
        FR
      </a>
      <a
        href={withBase("/en/")}
        hreflang="en"
        data-lang-seg="en"
        aria-current={lang === "en" ? "true" : "false"}
        class="relative z-10 w-[26px] py-[3px] text-center font-narrow text-[10px] leading-none font-bold text-ink transition-colors duration-200 aria-[current=true]:text-band"
      >
        EN
      </a>
    </div>
  </div>

  <div class="flex flex-col gap-[9px] bg-ink px-5 pt-[11px] pb-3">
    <label class="flex items-center gap-2 rounded-md bg-band px-3 py-[9px]">
      <span class="text-[15px] text-[#6b5510]" aria-hidden="true">⌕</span>
      <input
        type="search"
        data-search
        aria-label={t.searchPlaceholder}
        placeholder={t.searchPlaceholder}
        class="w-full bg-transparent font-body text-[14px] font-semibold text-ink placeholder:text-[#6b5510]/70 focus:outline-none"
      />
    </label>

    <p class="text-center font-narrow text-[13px] font-semibold">
      <span class="text-band">{t.hours}</span>
      <span
        class="mx-2 inline-block h-1 w-1 rounded-full bg-terracotta align-middle"
        aria-hidden="true"></span>
      <span class="text-sand">{t.service}</span>
    </p>
  </div>

</header>

<nav
  data-rail
  aria-label={lang === "fr" ? "Catégories" : "Categories"}
  class="rail sticky top-0 z-30 flex gap-[7px] overflow-x-auto border-b-[3px] border-ink bg-band px-5 py-[9px] lg:px-6"
>
    <button
      type="button"
      data-tab="all"
      aria-pressed="true"
      class="shrink-0 rounded-full border-2 border-ink bg-white/55 px-3 py-1.5 font-tab text-[12.5px] font-extrabold text-ink aria-pressed:bg-ink aria-pressed:text-band"
    >
      {t.allCategories}
    </button>
    {
      categories.map((category) => (
        <button
          type="button"
          data-tab={category}
          aria-pressed="false"
          data-here="false"
          class="shrink-0 rounded-full border-2 border-ink bg-white/55 px-3 py-1.5 font-tab text-[12.5px] font-extrabold text-ink aria-pressed:bg-ink aria-pressed:text-band data-[here=true]:bg-terracotta data-[here=true]:text-white"
        >
          {t.categories[category]}
        </button>
      ))
    }
</nav>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  // Let the knob finish its slide before the page changes under it.
  const knob = document.querySelector<HTMLElement>("[data-lang-knob]");
  document.querySelectorAll<HTMLAnchorElement>("[data-lang-seg]").forEach((segment) => {
    segment.addEventListener("click", (event) => {
      if (segment.getAttribute("aria-current") === "true") {
        event.preventDefault();
        return;
      }
      if (reduced.matches || !knob) return;

      event.preventDefault();
      knob.classList.toggle("translate-y-full");
      document.querySelectorAll<HTMLElement>("[data-lang-seg]").forEach((other) => {
        other.setAttribute("aria-current", String(other === segment));
      });
      window.setTimeout(() => {
        window.location.href = segment.href;
      }, 210);
    });
  });
</script>
