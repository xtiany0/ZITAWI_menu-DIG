---
import { ui, HOURS, type Lang } from "../i18n/ui";
import type { CATEGORIES } from "../content.config";

interface Props {
  lang: Lang;
  categories: (typeof CATEGORIES)[number][];
}

const { lang, categories } = Astro.props;
const t = ui[lang];

const emoji: Record<(typeof CATEGORIES)[number], string> = {
  pizzas: "🍕",
  plats: "🍔",
  sandwichs: "🥪",
  boissons: "🥤",
};
---

<header class="sticky top-0 z-40">
  <div class="bg-brick">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 lg:px-8 lg:py-4">
      <a href={`/${lang}/`} class="flex flex-col leading-none">
        <span class="font-display text-[1.75rem] leading-none font-black tracking-[0.04em] text-sign lg:text-4xl">
          ZITAWI
        </span>
        <span class="mt-1 text-[0.55rem] tracking-[0.28em] text-on-brick/75 uppercase lg:text-[0.65rem]">
          {t.tagline}
        </span>
      </a>

      <p
        data-open-state
        data-open-hour={HOURS.open}
        data-close-hour={HOURS.close}
        data-closed-label={t.closedNow}
        class="hidden items-center gap-2 rounded-full bg-black/25 px-4 py-1.5 text-sm text-on-brick sm:flex"
      >
        <span class="h-2 w-2 rounded-full bg-whatsapp" aria-hidden="true"></span>
        <span><span data-open-label>{t.openNow}</span>{`, ${HOURS.open}h-${HOURS.close}h`}</span>
      </p>

      <div class="flex shrink-0 items-center gap-2">
        <button
          type="button"
          data-search-toggle
          aria-expanded="false"
          aria-controls="menu-search"
          aria-label={t.searchLabel}
          class="grid h-11 w-11 cursor-pointer place-items-center rounded-full bg-black/20 text-on-brick transition-colors duration-200 hover:bg-black/35"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
          </svg>
        </button>

        <a
          href={t.otherLangHref}
          hreflang={lang === "fr" ? "en" : "fr"}
          class="grid h-11 min-w-11 cursor-pointer place-items-center rounded-full bg-black/20 px-3 text-sm font-semibold text-on-brick transition-colors duration-200 hover:bg-black/35"
        >
          {t.otherLang}
        </a>
      </div>
    </div>
  </div>

  <div class="border-b border-line bg-ground">
    <div class="mx-auto max-w-6xl px-4 lg:px-8">
      <div id="menu-search" hidden class="pt-3">
        <input
          type="search"
          data-search-input
          aria-label={t.searchLabel}
          placeholder={t.searchPlaceholder}
          class="h-11 w-full rounded-full border border-line bg-card px-4 text-sm text-ink placeholder:text-muted"
        />
      </div>

      <nav aria-label={lang === "fr" ? "Catégories" : "Categories"}>
        <ul class="pill-row flex gap-2 overflow-x-auto py-3">
          {
            categories.map((category) => (
              <li>
                <a
                  href={`#${category}`}
                  data-category-link={category}
                  class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-full bg-card px-4 text-sm whitespace-nowrap text-ink transition-colors duration-200 hover:bg-card-hi aria-[current=true]:bg-orange aria-[current=true]:text-on-orange aria-[current=true]:font-semibold"
                >
                  <span aria-hidden="true">{emoji[category]}</span>
                  {t.categories[category]}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  // Opening state
  const state = document.querySelector<HTMLElement>("[data-open-state]");
  const label = document.querySelector<HTMLElement>("[data-open-label]");
  if (state && label) {
    const open = Number(state.dataset.openHour);
    const close = Number(state.dataset.closeHour);
    const hour = new Date().getHours();
    if (hour < open || hour >= close) {
      label.textContent = state.dataset.closedLabel ?? label.textContent;
      const dot = state.querySelector("span");
      dot?.classList.remove("bg-whatsapp");
      dot?.classList.add("bg-muted");
    }
  }

  // Assigned below once the category links exist; the search handler calls it
  // after filtering so the active pill matches what is still on screen.
  let refreshCurrent = () => {};

  // Search toggle and filtering
  const toggle = document.querySelector<HTMLButtonElement>("[data-search-toggle]");
  const panel = document.getElementById("menu-search");
  const input = document.querySelector<HTMLInputElement>("[data-search-input]");

  toggle?.addEventListener("click", () => {
    if (!panel) return;
    const nowOpen = panel.hidden;
    panel.hidden = !nowOpen;
    toggle.setAttribute("aria-expanded", String(nowOpen));
    if (nowOpen) input?.focus();
  });

  input?.addEventListener("input", () => {
    const query = input.value.trim().toLowerCase();
    document.querySelectorAll<HTMLElement>("[data-dish]").forEach((card) => {
      card.hidden = query.length > 0 && !(card.dataset.dish ?? "").includes(query);
    });
    let shown = 0;
    document.querySelectorAll<HTMLElement>("[data-category-section]").forEach((section) => {
      const visible = section.querySelectorAll<HTMLElement>("[data-dish]:not([hidden])").length;
      section.hidden = visible === 0;
      shown += visible;
    });

    const empty = document.querySelector<HTMLElement>("[data-no-result]");
    if (empty) empty.hidden = shown > 0;

    refreshCurrent();
  });

  // Category underline follows the scroll
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-category-link]");
  const sections = document.querySelectorAll<HTMLElement>("[data-category-section]");

  if (links.length && sections.length) {
    const setCurrent = (id: string) => {
      links.forEach((link) => {
        link.setAttribute("aria-current", String(link.dataset.categoryLink === id));
      });
    };

    // Position-based rather than an IntersectionObserver: the observer needs a
    // detection band expressed in percentages, which collapsed to 85px on a
    // phone and let sections slip through without ever registering.
    const headerEl = document.querySelector("header");

    const updateCurrent = () => {
      const visible = [...sections].filter((section) => !section.hidden);
      if (!visible.length) return;

      // Slack past the header so a section counts as reached once its heading
      // clears the pills, not only when its very top edge does.
      const line = (headerEl?.getBoundingClientRect().height ?? 0) + 72;
      let current = visible[0];
      for (const section of visible) {
        if (section.getBoundingClientRect().top <= line) current = section;
      }

      const atBottom = window.innerHeight + window.scrollY >= document.body.scrollHeight - 4;
      if (atBottom) current = visible[visible.length - 1];

      setCurrent(current.dataset.categorySection ?? "");
    };

    let queued = false;
    window.addEventListener(
      "scroll",
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          updateCurrent();
          queued = false;
        });
      },
      { passive: true },
    );

    refreshCurrent = updateCurrent;
    updateCurrent();
  }
</script>
