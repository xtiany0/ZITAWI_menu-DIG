---
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  revision: string;
}

const { lang, revision } = Astro.props;
const t = ui[lang];
---

<header class="border-b-2 border-ink">
  <div class="flex items-stretch justify-between">
    <a href={`/${lang}/`} class="flex items-baseline gap-1 px-4 py-4 lg:px-6 lg:py-5">
      <span
        class="font-display text-[2rem] leading-[0.85] tracking-[-0.04em] uppercase lg:text-[2.75rem]"
      >
        Zitawi
      </span>
      <span class="text-[0.7rem] leading-none">®</span>
    </a>

    <a
      href={t.otherLangHref}
      hreflang={lang === "fr" ? "en" : "fr"}
      class="flex items-center border-l-2 border-ink px-5 text-xs tracking-[0.1em] uppercase transition-colors duration-150 hover:bg-accent hover:text-on-accent lg:px-8 lg:text-sm"
    >
      [ {t.otherLang} ]
    </a>
  </div>

  <dl
    class="grid grid-cols-2 gap-px border-t border-ink bg-ink text-[0.625rem] tracking-[0.1em] uppercase sm:grid-cols-4 lg:text-[0.7rem]"
  >
    <div class="bg-substrate px-4 py-2 lg:px-6">
      <dt class="text-ink-soft">ORIGINE</dt>
      <dd>{t.origin}</dd>
    </div>
    <div class="bg-substrate px-4 py-2 lg:px-6">
      <dt class="text-ink-soft">{t.service}</dt>
      <dd>{t.hours}</dd>
    </div>
    <div class="bg-substrate px-4 py-2 lg:px-6">
      <dt class="text-ink-soft">{t.contact}</dt>
      <dd>+228 90 00 00 00</dd>
    </div>
    <div class="bg-substrate px-4 py-2 lg:px-6">
      <dt class="text-ink-soft">REV</dt>
      <dd>{revision}</dd>
    </div>
  </dl>
</header>
