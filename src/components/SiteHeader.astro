---
import { ui, type Lang } from "../i18n/ui";
import type { CATEGORIES } from "../content.config";
import { withBase } from "../lib/path";

interface Props {
  lang: Lang;
  categories: (typeof CATEGORIES)[number][];
}

const { lang, categories } = Astro.props;
const t = ui[lang];

const segment =
  "relative z-10 w-[26px] rounded-[6px] py-[3px] text-center font-narrow text-[10px] leading-none font-bold text-seg-off transition-colors duration-200 aria-[current=false]:hover:bg-seg-hover aria-[current=true]:text-on-ink";

const tab =
  "shrink-0 rounded-full border border-tab-edge px-3 py-1.5 font-tab text-[12.5px] font-extrabold text-tab-off transition-colors aria-pressed:border-on aria-pressed:bg-on aria-pressed:text-on-ink";
---

<header>
  <!-- The signage banner is the one place 3a keeps 2a untouched, and the theme
       does not touch it either: terracotta ground, black wordmark ringed white. -->
  <div class="relative border-b-[5px] border-black bg-terracotta px-5 pt-[15px] pb-[13px] text-center">
    <!-- Only the wordmark row needs to clear the switch. The tagline sits below
         it, so padding it too is what pushed it onto two lines. -->
    <a
      href={withBase(`/${lang}/`)}
      class="logo block px-10 font-logo text-[34px] leading-none font-black tracking-[.11em]"
    >
      ZITAWI
    </a>
    <p class="mt-1 font-narrow text-[12px] font-semibold tracking-[.2em] text-blush uppercase">
      {t.tagline}
    </p>

    <div
      data-lang-switch
      class="absolute top-2 right-2 flex flex-col rounded-lg border-2 border-switch-edge bg-switch-bg p-[2px] shadow-[2px_2px_0_var(--color-switch-edge)]"
    >
      <span
        data-lang-knob
        aria-hidden="true"
        class:list={[
          "absolute top-[2px] left-[2px] h-[calc(50%-2px)] w-[calc(100%-4px)] rounded-[6px] bg-on transition-transform duration-200 ease-out",
          lang === "en" && "translate-y-full",
        ]}
      />
      <a href={withBase("/fr/")} hreflang="fr" data-lang-seg="fr" aria-current={lang === "fr" ? "true" : "false"} class={segment}>
        FR
      </a>
      <a href={withBase("/en/")} hreflang="en" data-lang-seg="en" aria-current={lang === "en" ? "true" : "false"} class={segment}>
        EN
      </a>
    </div>
  </div>

  <div class="border-b border-hair bg-paper px-5 pt-[11px] pb-3">
    <label class="flex items-center gap-2 rounded-lg border border-edge bg-field px-3 py-[9px]">
      <span class="text-[15px] text-icon" aria-hidden="true">⌕</span>
      <input
        type="search"
        data-search
        aria-label={t.searchPlaceholder}
        placeholder={t.searchPlaceholder}
        class="w-full bg-transparent font-body text-[14px] font-semibold text-ink placeholder:text-muted/70 focus:outline-none"
      />
    </label>
  </div>
</header>

<!-- The theme button keeps its place while the categories scroll past it, so
     the row that scrolls is the inner one, not the sticky bar. -->
<div
  data-rail
  class="sticky top-0 z-30 flex items-center gap-[7px] border-b border-hair bg-paper px-5 py-[9px]"
>
  <button
    type="button"
    data-theme-toggle
    class="shrink-0 rounded-full border border-edge bg-field px-[11px] py-1.5 font-tab text-[12.5px] font-bold text-ink"
  >
    <span data-theme-label>{t.themeToDark}</span>
  </button>

  <nav
    data-tabs
    aria-label={lang === "fr" ? "Catégories" : "Categories"}
    class="rail flex min-w-0 flex-1 gap-[7px] overflow-x-auto"
  >
    <button type="button" data-tab="all" aria-pressed="true" class={tab}>{t.allCategories}</button>
    {
      categories.map((category) => (
        <button type="button" data-tab={category} aria-pressed="false" data-here="false" class={`${tab} data-[here=true]:border-band data-[here=true]:text-on`}>
          {t.categories[category]}
        </button>
      ))
    }
  </nav>
</div>

<script>
  // Let the knob finish its slide before the page changes under it.
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  const knob = document.querySelector<HTMLElement>("[data-lang-knob]");

  document.querySelectorAll<HTMLAnchorElement>("[data-lang-seg]").forEach((segment) => {
    segment.addEventListener("click", (event) => {
      if (segment.getAttribute("aria-current") === "true") {
        event.preventDefault();
        return;
      }
      if (reduced.matches || !knob) return;

      event.preventDefault();
      knob.classList.toggle("translate-y-full");
      document.querySelectorAll<HTMLElement>("[data-lang-seg]").forEach((other) => {
        other.setAttribute("aria-current", String(other === segment));
      });
      window.setTimeout(() => {
        window.location.href = segment.href;
      }, 210);
    });
  });

  // The theme itself is already applied: a blocking script in the document head
  // set it before the first paint. This only relabels the button and takes over
  // the choice from here on.
  const root = document.documentElement;
  const label = document.querySelector<HTMLElement>("[data-theme-label]");
  const copy = JSON.parse(root.dataset.themeCopy ?? "{}");

  function paint() {
    const dark = root.dataset.theme === "dark";
    if (label) label.textContent = dark ? copy.toLight : copy.toDark;
    document
      .querySelector("[data-theme-toggle]")
      ?.setAttribute("aria-label", dark ? copy.toLight : copy.toDark);
  }

  paint();

  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("zitawi-theme", next);
    } catch {
      // Private windows throw. The toggle still works for this page view.
    }
    paint();
  });
</script>
