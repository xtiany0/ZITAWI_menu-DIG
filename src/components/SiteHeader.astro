---
import { ui, type Lang } from "../i18n/ui";
import type { CATEGORIES } from "../content.config";
import { withBase } from "../lib/path";

interface Props {
  lang: Lang;
  categories: (typeof CATEGORIES)[number][];
}

const { lang, categories } = Astro.props;
const t = ui[lang];

const segment =
  "rounded-full px-[11px] py-[5px] font-narrow text-[13px] leading-none font-bold text-ink transition-colors aria-[current=true]:bg-ink aria-[current=true]:text-band hover:bg-band aria-[current=true]:hover:bg-ink";

const tab =
  "shrink-0 rounded-full border border-tab-edge px-3 py-1.5 font-tab text-[12.5px] font-extrabold text-muted transition-colors aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-band";
---

<header>
  <!-- The signage banner is the one place 3a keeps 2a untouched. -->
  <!-- The handoff draws this at 430px, where the wordmark clears the switch on
       its own. Under 375px it no longer does, so the switch keeps its corner and
       the wordmark drops below it rather than shrinking. -->
  <div class="relative border-b-[5px] border-ink bg-terracotta px-5 pt-[15px] pb-[13px] text-center max-[374px]:pt-[58px]">
    <a
      href={withBase(`/${lang}/`)}
      class="logo block px-[86px] font-logo text-[34px] leading-none font-black tracking-[.11em] max-[374px]:px-0"
    >
      ZITAWI
    </a>
    <p class="mt-1 font-narrow text-[12px] font-semibold tracking-[.2em] text-blush uppercase">
      {t.tagline}
    </p>

    <div
      class="absolute top-[14px] right-4 flex rounded-full border-2 border-ink bg-cream p-[2px] shadow-[2px_2px_0_#141210]"
    >
      <a href={withBase("/fr/")} hreflang="fr" aria-current={lang === "fr" ? "true" : "false"} class={segment}>
        FR
      </a>
      <a href={withBase("/en/")} hreflang="en" aria-current={lang === "en" ? "true" : "false"} class={segment}>
        EN
      </a>
    </div>
  </div>

  <div class="border-b border-hair bg-paper px-5 pt-[11px] pb-3">
    <label class="flex items-center gap-2 rounded-lg border border-edge bg-white px-3 py-[9px]">
      <span class="text-[15px] text-muted" aria-hidden="true">⌕</span>
      <input
        type="search"
        data-search
        aria-label={t.searchPlaceholder}
        placeholder={t.searchPlaceholder}
        class="w-full bg-transparent font-body text-[14px] font-semibold text-ink placeholder:text-muted/70 focus:outline-none"
      />
    </label>
  </div>
</header>

<nav
  data-rail
  aria-label={lang === "fr" ? "Catégories" : "Categories"}
  class="rail sticky top-0 z-30 flex gap-[7px] overflow-x-auto border-b border-hair bg-paper px-5 py-[9px]"
>
  <button type="button" data-tab="all" aria-pressed="true" class={tab}>{t.allCategories}</button>
  {
    categories.map((category) => (
      <button type="button" data-tab={category} aria-pressed="false" data-here="false" class={`${tab} data-[here=true]:border-band data-[here=true]:bg-band data-[here=true]:text-ink`}>
        {t.categories[category]}
      </button>
    ))
  }
</nav>
