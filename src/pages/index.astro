---
export const prerender = true;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Zitawi</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0; url=/fr/" />
    <link rel="canonical" href="https://zitawi.com/fr/" />
  </head>
  <body>
    <p><a href="/fr/">Voir la carte</a> · <a href="/en/">See the menu</a></p>
    <script is:inline>
      var target = (navigator.language || "fr").toLowerCase().startsWith("en") ? "/en/" : "/fr/";
      window.location.replace(target);
    </script>
  </body>
</html>
