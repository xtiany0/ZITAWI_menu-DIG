---
import { withBase } from "../lib/path";

export const prerender = true;

const fr = withBase("/fr/");
const en = withBase("/en/");
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Zitawi</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${fr}`} />
    <link rel="canonical" href={new URL(fr, Astro.site)} />
  </head>
  <body>
    <p><a href={fr}>Voir la carte</a> · <a href={en}>See the menu</a></p>
    <script is:inline define:vars={{ fr, en }}>
      window.location.replace((navigator.language || "fr").toLowerCase().startsWith("en") ? en : fr);
    </script>
  </body>
</html>
