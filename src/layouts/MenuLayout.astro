---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const t = ui[lang];
const canonical = new URL(`/${lang}/`, Astro.site);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL("/fr/", Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", Astro.site)} />
    <meta name="theme-color" content="#08080c" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="restaurant.menu" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="relative min-h-dvh bg-bg font-display text-ink antialiased">
    <a
      href="#carte"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-70 focus:rounded-full focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:text-on-accent"
    >
      {t.skip}
    </a>

    <div class="pointer-events-none absolute inset-x-0 top-0 h-[70rem] overflow-hidden" aria-hidden="true">
      <div class="absolute inset-0 aurora opacity-60"></div>
      <div class="absolute inset-0 grid-field"></div>
    </div>

    <div class="relative">
      <slot />
    </div>

    <script>
      const revealed = document.querySelectorAll<HTMLElement>(".reveal");
      const motionOk = window.matchMedia("(prefers-reduced-motion: no-preference)").matches;

      if (motionOk && revealed.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                (entry.target as HTMLElement).dataset.shown = "true";
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        revealed.forEach((element) => observer.observe(element));
      } else {
        revealed.forEach((element) => (element.dataset.shown = "true"));
      }
    </script>
  </body>
</html>
