---
import "@fontsource/archivo-black";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const t = ui[lang];
const canonical = new URL(`/${lang}/`, Astro.site);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL("/fr/", Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", Astro.site)} />
    <meta name="theme-color" content="#f4f4f0" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="restaurant.menu" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="bg-ink font-mono text-ink">
    <a
      href="#carte"
      class="sr-only focus:not-sr-only focus:fixed focus:top-0 focus:left-0 focus:z-70 focus:bg-accent focus:px-4 focus:py-2 focus:text-xs focus:tracking-[0.1em] focus:text-on-accent"
    >
      {t.skip}
    </a>
    <div class="grain" aria-hidden="true"></div>
    <div class="mx-auto max-w-[1400px] border-x border-ink bg-substrate">
      <slot />
    </div>
  </body>
</html>
