---
import "@fontsource-variable/bodoni-moda";
import "@fontsource-variable/archivo";
import "@fontsource-variable/archivo-narrow";
import "@fontsource-variable/cairo";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import { ui, type Lang } from "../i18n/ui";
import { withBase } from "../lib/path";

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const t = ui[lang];
const themeCopy = JSON.stringify({ toDark: t.themeToDark, toLight: t.themeToLight });
const canonical = new URL(withBase(`/${lang}/`), Astro.site);
---

<!doctype html>
<html lang={t.htmlLang} data-theme-copy={themeCopy}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL(withBase("/fr/"), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(withBase("/en/"), Astro.site)} />
    <meta name="theme-color" content="#b8452f" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="restaurant.menu" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <script is:inline>
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";

      // Blocking on purpose. The theme has to be on the element before the
      // first paint, or a dark reader gets a flash of the cream page.
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem("zitawi-theme");
        } catch (error) {
          // Private windows throw on read as well as on write.
        }
        if (stored !== "light" && stored !== "dark") {
          stored = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = stored;
      })();
    </script>
  </head>
  <body class="bg-paper">
    <a
      href="#carte"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-black focus:px-4 focus:py-2 focus:font-body focus:text-sm focus:text-band"
    >
      {t.skip}
    </a>

    <!-- Drawn at 430px. Fluid to 100%, capped at the 480px the handoff asks for
         and centred, so a desktop shows the same card rather than a wider one. -->
    <div class="mx-auto flex min-h-dvh w-full max-w-[480px] flex-col bg-paper">
      <slot />
    </div>
  </body>
</html>
