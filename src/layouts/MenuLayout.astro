---
import "@fontsource/playfair-display-sc/400.css";
import "@fontsource/playfair-display-sc/700.css";
import "@fontsource-variable/karla";
import "../styles/global.css";
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const t = ui[lang];
const canonical = new URL(`/${lang}/`, Astro.site);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL("/fr/", Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", Astro.site)} />
    <meta name="theme-color" content="#fef2f2" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="restaurant.menu" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="min-h-dvh bg-paper font-sans text-ink">
    <a
      href="#carte"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-70 focus:bg-red focus:px-4 focus:py-2 focus:text-sm focus:text-on-red"
    >
      {t.skip}
    </a>

    <slot />

    <script>
      const revealed = document.querySelectorAll<HTMLElement>(".reveal");
      const motionOk = window.matchMedia("(prefers-reduced-motion: no-preference)").matches;

      if (motionOk && revealed.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                (entry.target as HTMLElement).dataset.shown = "true";
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -6% 0px", threshold: 0.05 },
        );
        revealed.forEach((element) => observer.observe(element));
      } else {
        revealed.forEach((element) => (element.dataset.shown = "true"));
      }
    </script>
  </body>
</html>
